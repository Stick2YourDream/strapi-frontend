# Production build settings (used by `vite build`)
#
# Vite loads env files in this order:
#   .env
#   .env.local
#   .env.production
#   .env.production.local
#
# This file intentionally overrides values from `.env.local` so production builds
# don't bake in localhost URLs or dev-only Newsroom settings.

VITE_API_URL=https://s2yd-a2gaeva9aaajaybp.westus3-01.azurewebsites.net/api
VITE_SOCKET_URL=https://s2yd-a2gaeva9aaajaybp.westus3-01.azurewebsites.net

# Use Strapi as the Newsroom proxy in production.
VITE_NEWS_ACCESS_MODE=proxy

# Disable client-side direct access/fallback to the Vite dev proxy (/news-proxy).
VITE_NEWS_API_URL=

# Ensure VideoCall control-helper defaults to the API base (not localhost).
VITE_CONTROL_HELPER_URL=

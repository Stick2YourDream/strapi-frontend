{
  "name": "jason-adams",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:video": "vite --mode video",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "tsc -b && vite build",
    "build:video": "tsc -b && vite build --mode video",
    "build:ssr": "vite build --ssr src/entry-ssg.tsx --outDir dist-ssg",
    "lint": "eslint .",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "npx serve -s dist -l 4173"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@giphy/js-fetch-api": "^5.7.0",
    "@giphy/react-components": "^10.1.1",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "axios": "^1.7.7",
    "gsap": "^3.14.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.2",
    "react-resizable": "^3.0.7",
    "react-router-dom": "^7.10.1",
    "serve": "^14.2.1",
    "socket.io-client": "^4.8.3"
  }
}
